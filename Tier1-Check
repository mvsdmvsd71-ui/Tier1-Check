function Show-CyberProgress {
    param([string]$TaskName, [int]$MS = 300)
    $spinChars = @('⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏')
    $steps = 5
    for ($i = 0; $i -le $steps; $i++) {
        $char = $spinChars[$i % $spinChars.Count]
        $percent = $i * 20
        $barLength = 15
        $filled = [math]::Round(($percent / 100) * $barLength)
        $unfilled = $barLength - $filled
        $bar = ("█" * $filled) + ("░" * $unfilled)
        
        Write-Host "`r  $($C.NeonPink)$char$($C.Reset) $($C.NeonCyan)[$bar] $percent%$($C.Reset) $($C.GhostWhite)$TaskName...$($C.Reset)" -NoNewline
        Start-Sleep -Milliseconds ($MS / $steps)
    }
    Write-Host "`r  $($C.NeonGreen)✔$($C.Reset) $($C.NeonCyan)[███████████████] 100%$($C.Reset) $($C.GhostWhite)$TaskName [TAMAMLANDI]$($C.Reset)                 "
}

