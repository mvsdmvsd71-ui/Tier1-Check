Show-CyberProgress -TaskName "[54/55] Shellbags (Silinmiş Klasör İzleri) Taranıyor"
try {
    $shellbagsPath = "HKCU:\Software\Classes\Local Settings\Software\Microsoft\Windows\Shell\Bags"
    $suspiciousKeywords = @("hile", "cheat", "injector", "bypass", "exploit", "aimbot", "spoofer", "solara", "krnl")
    $flaggedBags = @()

    if (Test-Path $shellbagsPath) {
        $bags = Get-ChildItem -Path $shellbagsPath -Recurse -ErrorAction SilentlyContinue
        foreach ($bag in $bags) {
            foreach ($prop in $bag.Property) {
                $val = Get-ItemPropertyValue -Path $bag.PSPath -Name $prop -ErrorAction SilentlyContinue
                foreach ($kw in $suspiciousKeywords) {
                    if ($val -like "*$kw*") {
                        $flaggedBags += "$val"
                    }
                }
            }
        }
    }
    if ($flaggedBags.Count -gt 0) {
        $uniqueBags = ($flaggedBags | Select-Object -Unique) -join " | "
        Add-ReportItem "CRITICAL" "Shellbags Kayıtlarında Şüpheli Klasör İzi Bulundu!" $uniqueBags
    } else {
        Add-ReportItem "CLEAN" "Shellbags Kayıtları Temiz" "Kayıt defterinde silinmiş şüpheli klasör adını rastlanmadı."
    }
} catch {
    Add-ReportItem "WARNING" "Shellbags Taraması Yapılamadı" $_.Exception.Message
}

# [55] LASTACTIVITYVIEW TARZI OTURUM AÇILDIĞINDAN BERİ AÇILAN TÜM DOSYALARIN MASAÜSTÜNE RAPORLANMASI
Show-CyberProgress -TaskName "[55/55] Oturum Açıldığından Beri Erişilen Tüm Dosyalar Raporlanıyor"
try {
    $bootTime = (Get-CimInstance -ClassName Win32_OperatingSystem).LastBootUpTime
    $sessionHeader = @"
===============================================================================
 TITAN CHECK v19.0 - LAST ACTIVITY SESSION REPORT
 Oturum Başlangıç Zamanı: $bootTime
 Rapor Oluşturulma Zamanı: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')
===============================================================================
[OTURUM AÇILDIĞINDAN BERİ ERİŞİLEN / AÇILAN TÜM DOSYALAR VE KISAYOLLAR]

"@
    $sessionHeader | Out-File -FilePath $SessionReportPath -Encoding utf8

    $recentPath = "$env:APPDATA\Microsoft\Windows\Recent"
    if (Test-Path $recentPath) {
        Get-ChildItem -Path $recentPath -ErrorAction SilentlyContinue | 
            Where-Object { $_.LastWriteTime -ge $bootTime } | 
            Sort-Object LastWriteTime -Descending | 
            ForEach-Object {
                " Zaman: $($_.LastWriteTime.ToString('HH:mm:ss')) | Dosya/Kısayol: $($_.Name)" | Out-File -FilePath $SessionReportPath -Append -Encoding utf8
            }
    }

    "`n===============================================================================" | Out-File -FilePath $SessionReportPath -Append -Encoding utf8
    "[OTURUM SÜRESİNCE ÇALIŞTIRILAN TÜM UYGULAMALAR (PREFETCH EXECS)]" | Out-File -FilePath $SessionReportPath -Append -Encoding utf8
    "===============================================================================" | Out-File -FilePath $SessionReportPath -Append -Encoding utf8

    $prefetchPath = "$env:SystemRoot\Prefetch"
    if (Test-Path $prefetchPath) {
        Get-ChildItem -Path $prefetchPath -Filter "*.pf" -ErrorAction SilentlyContinue | 
            Where-Object { $_.LastWriteTime -ge $bootTime } | 
            Sort-Object LastWriteTime -Descending | 
            ForEach-Object {
                " Zaman: $($_.LastWriteTime.ToString('HH:mm:ss')) | Exe İzi: $($_.Name)" | Out-File -FilePath $SessionReportPath -Append -Encoding utf8
            }
    }

    Add-ReportItem "CLEAN" "Oturum Aktivite Raporu Oluşturuldu" "Masaüstüne aktarıldı: TITAN_Session_Activity_Report.txt"
} catch {
    Add-ReportItem "WARNING" "Oturum Aktivite Raporu Hatası" $_.Exception.Message
}

